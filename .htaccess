Options -Indexes
DirectoryIndex index.php
<FilesMatch "(?i)\.(xlsx|csv|sql|md|py|log|zip)$|^config.*\.php$">
Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\.git(?:/|$) - [F,L]
RewriteRule (^|/)\.env(?:\..*)?$ - [F,L]
RewriteRule ^\.cpanel\.yml$ - [F,L]
RewriteRule ^(?:storage|data|scripts|app|tests|dist)/ - [F,L]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
